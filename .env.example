# =====================================================================
# Skill 制造工厂后端 环境变量配置模板
#
# 使用方法：
#   cp .env.example .env
#   编辑 .env 填写实际配置
#
# 注意：
#   - .env 文件包含敏感信息，不能提交到 Git 仓库
#   - 生产环境建议使用 Docker Secrets 或 Kubernetes Secrets 管理密钥
# =====================================================================

# ------------------------------------------------------------------
# Flask 应用配置
# ------------------------------------------------------------------

# 运行环境：development / production / testing
FLASK_ENV=development

# 应用密钥（生产环境必须设置为强随机值）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-strong-random-secret-key

# ------------------------------------------------------------------
# 数据库配置（PostgreSQL）
# ------------------------------------------------------------------

DB_NAME=skillfactory
DB_USER=skilluser
DB_PASSWORD=please-change-this-password
# 完整 URL（docker-compose 中会自动构建，本地开发可直接设置）
# DATABASE_URL=postgresql://skilluser:skillpass@localhost:5432/skillfactory

# ------------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------------

REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------
# 加密密钥（用于 API Key 的 Fernet 加密存储）
# 生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------------------------------

ENCRYPTION_KEY=

# ------------------------------------------------------------------
# 服务端口配置
# ------------------------------------------------------------------

# API 服务对外暴露端口
API_PORT=5000

# Celery Flower 监控面板端口
FLOWER_PORT=5555

# ------------------------------------------------------------------
# 沙盒测试配置
# ------------------------------------------------------------------

# 沙盒 Docker 镜像名称（需要预先构建）
SANDBOX_DOCKER_IMAGE=skillfactory-sandbox:latest

# 沙盒执行超时时间（秒）
SANDBOX_TIMEOUT_SECONDS=60

# 沙盒容器内存限制
SANDBOX_MEMORY_LIMIT=256m

# 沙盒容器 CPU 限制（核数）
SANDBOX_CPU_LIMIT=0.5

# 前端访问端口
FRONTEND_PORT=3000

# ------------------------------------------------------------------
# 模型配置（可在系统运行后通过 API 添加，此处为备用环境变量）
# ------------------------------------------------------------------

# 默认模型 API Key（可选，推荐通过 /api/v1/config/models 接口配置）
# DEFAULT_MODEL_API_KEY=sk-your-api-key-here
# DEFAULT_MODEL_NAME=gpt-4o
# DEFAULT_MODEL_BASE_URL=
